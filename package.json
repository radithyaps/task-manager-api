{
  "name": "task-manager-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API untuk task pribadi dengan Express, Prisma, dan PostgreSQL.",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --watch src --ext js src/index.js",
    "test": "npm exec --yes --package=newman@6.2.3 -- newman run postman_collection.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.12.1",
    "prisma": "6.19.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "nodemon": "3.1.14"
  },
  "overrides": {
    "@prisma/config@6.19.3": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.5"
    },
    "nodemon@3.1.14": {
      "minimatch": "11.0.9"
    }
  }
}
