# Salin ke .env. Untuk Docker lokal cukup isi JWT_SECRET dan POSTGRES_PASSWORD.
# Untuk setiap nilai, buat rahasia berbeda: node -p "require('node:crypto').randomBytes(32).toString('hex')"
JWT_SECRET=
POSTGRES_PASSWORD=
POSTGRES_PORT=55432

# Untuk Node di luar Docker. Di Render, masukkan URL Neon langsung di dashboard.
# DATABASE_URL: pooled (host berisi -pooler), DIRECT_URL: direct, database yang sama.
DATABASE_URL=
DIRECT_URL=

BCRYPT_SALT_ROUNDS=12

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
TRUST_PROXY_HOPS=0
